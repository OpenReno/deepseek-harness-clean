{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "title": "DeepSeek Harness",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "visible": false,
        "decorations": true,
        "resizable": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  },
  "build": {
    "beforeDevCommand": "node ../scripts/sidecar-build.mjs --dev",
    "beforeBuildCommand": "node ../scripts/sidecar-build.mjs",
    "devUrl": "http://127.0.0.1:3080",
    "frontendDist": "../apps/web/dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dsh-runtime/lib/bin.js": "dsh-runtime/lib/bin.js",
      "../dsh-runtime/lib": "dsh-runtime/lib",
      "../dsh-runtime/config": "dsh-runtime/config",
      "../dsh-runtime/node_modules": "dsh-runtime/node_modules",
      "../dsh-runtime/package.json": "dsh-runtime/package.json",
      "../node": "node",
      "../python": "python"
    },
    "category": "DeveloperTool",
    "shortDescription": "DeepSeek Harness — AI agent harness, zero-install desktop",
    "longDescription": "Bundles Node.js + Python + the upstream dsh runtime. No external dependencies required."
  },
  "identifier": "ai.deepseek.harness.desktop",
  "plugins": {
    "deep-link": {
      "schemes": [
        "dsh"
      ]
    },
    "updater": {
      "endpoints": [
        "https://releases.deepseek-harness.dev/latest.json"
      ],
      "pubkey": "KECPcYT89HHxO7yCiYdc/deDbkFLA6iwdOguYzuQxeg="
    }
  },
  "productName": "DeepSeek Harness",
  "version": "0.1.1-rc.2"
}
