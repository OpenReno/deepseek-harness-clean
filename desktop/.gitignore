# Tauri build artifacts
src-tauri/target/
src-tauri/Cargo.lock
# Updater signing key — generated by scripts/generate-signer.mjs, fed back
# via TAURI_SIGNER_PRIVATE_KEY in CI. Never commit: a leak lets anyone push
# forged updates to installed clients.
src-tauri/signer.key

# Sidecar bundle artifacts (regenerated by `pnpm --dir desktop run build`)
dsh-runtime/
node/
python/
# Local mirror of apps/web/dist that some older docs pointed at as the
# production frontend root. The actual Vite output lives one level up at
# ../../apps/web/dist (workspace root); see tauri.conf.json -> build.frontendDist.
# Keep this entry so a future local mirror can't be committed by mistake.
apps/web/
